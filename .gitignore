# Build artifacts (regenerable via CMake/meson/pkgbuild)
plugin/build/
plugin/build-release/
packaging/build/
aec3-offline-test/*.o
aec3-offline-test/aec3_offline_test
aec3-offline-test/peaks/

# JUCE and webrtc-audio-processing are git submodules (see .gitmodules) --
# tracked via gitlink, not ignored. A public release needs both actually
# buildable from a fresh clone, which a blanket ignore here would break.

# Real test recordings and generated harness/test outputs (WAVs, CSV
# reports) -- large binary material, not source, and not something that
# needs a diffable history.
temp/
*.wav
*.csv

.DS_Store
